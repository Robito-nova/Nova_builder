{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.example/schemas/nova-1.0.schema.json",
  "title": "NOVA Application Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "schemaVersion", "app", "runtime", "dependencies", "permissions", "resources", "build", "package"],
  "properties": {
    "manifestVersion": {"const": "1.0"},
    "schemaVersion": {"const": "1.0"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "version", "type", "entryPoint", "language", "arch", "platforms"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9]+([.-][a-zA-Z0-9]+)+$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
        "description": {"type": "string"},
        "developer": {"type": "string"},
        "type": {"enum": ["desktop", "cli", "service", "library", "plugin"]},
        "entryPoint": {"type": "string", "minLength": 1},
        "language": {"enum": ["python", "c"]},
        "arch": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "x86_64"}},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "windows"]}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "fallback"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "fallback": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "libraries", "modules"],
      "properties": {
        "system": {"type": "array", "items": {"type": "string"}},
        "libraries": {"type": "array", "items": {"type": "string"}},
        "modules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "hardware"],
      "properties": {
        "network": {"type": "boolean"},
        "filesystem": {"type": "array", "items": {"type": "string"}},
        "hardware": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icons", "locales", "assets"],
      "properties": {
        "icons": {"type": "array", "items": {"type": "string"}},
        "locales": {"type": "array", "items": {"type": "string"}},
        "assets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain", "target", "output"],
      "properties": {
        "toolchain": {"enum": ["python", "c"]},
        "target": {"enum": ["linux-arch-x86_64", "linux-debian-x86_64", "windows-x86_64"]},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "format", "launcher", "installMode", "executableLike", "icon"],
      "properties": {
        "kind": {"enum": ["application", "service", "plugin", "toolkit"]},
        "format": {"const": "nova"},
        "launcher": {"type": "string", "minLength": 1},
        "installMode": {"enum": ["portable"]},
        "executableLike": {"type": "boolean"},
        "icon": {"type": "string"}
      }
    }
  }
}
