{
  "manifestVersion": "1.0",
  "schemaVersion": "1.0",
  "app": {
    "name": "nova _builder",
    "id": "org.nova.nova.builder",
    "version": "0.1.0",
    "description": "",
    "developer": "",
    "type": "desktop",
    "entryPoint": "src/main.py",
    "language": "python",
    "arch": [
      "x86_64"
    ],
    "platforms": [
      "linux"
    ]
  },
  "runtime": {
    "required": [
      "python>=3.12"
    ],
    "fallback": []
  },
  "dependencies": {
    "system": [],
    "libraries": [],
    "modules": []
  },
  "permissions": {
    "network": false,
    "filesystem": [],
    "hardware": []
  },
  "resources": {
    "icons": [],
    "locales": [],
    "assets": []
  },
  "build": {
    "toolchain": "python",
    "target": "linux-debian-x86_64",
    "output": "build/outputs/linux-debian-x86_64"
  },
  "package": {
    "kind": "application",
    "format": "nova",
    "launcher": "src/main.py",
    "installMode": "portable",
    "executableLike": true,
    "icon": ""
  }
}
